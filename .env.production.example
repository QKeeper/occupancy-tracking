# Production Environment Configuration
# ====================================

# Database connection to the existing PostgreSQL instance on host:
# Option 1 (Docker with extra_hosts):
DATABASE_URL=postgresql://occupancy_user:YOUR_STRONG_PASSWORD@host.docker.internal:5432/occupancy_tracking

# Option 2 (PM2 / direct node execution or host networking):
# DATABASE_URL=postgresql://occupancy_user:YOUR_STRONG_PASSWORD@127.0.0.1:5432/occupancy_tracking

# Server Port
PORT=3001
HOST_BIND_IP=127.0.0.1

# Allowed origins for CORS (your domain and protocols)
APP_ORIGINS=https://your-domain.com,http://your-domain.com

# Cookie security - set to true if using HTTPS behind reverse proxy (Nginx/Caddy)
COOKIE_SECURE=true

# Local calendar timezone for schedule engine calculations
SCHEDULE_TIMEZONE=Asia/Yekaterinburg
