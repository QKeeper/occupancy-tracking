# Example environment variables
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/occupancy_tracking
PORT=3001
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set true when the site is served over HTTPS behind a reverse proxy.
COOKIE_SECURE=false
# Local calendar zone used when converting manual HH:MM ranges to timestamptz.
SCHEDULE_TIMEZONE=Asia/Yekaterinburg
